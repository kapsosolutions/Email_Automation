    "express": "4.21.2",
    "ioredis": "5.4.2",
    "mongoose": "8.9.5",
    "morgan": "1.10.0",
    "multer": "2.0.2",
    "nodemailer": "6.9.16",
    "xlsx": "0.18.5"
